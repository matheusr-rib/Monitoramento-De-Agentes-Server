# Score Admin - servidor interno 192.168.1.115
NODE_ENV=production
SERVER_BIND_IP=192.168.1.115
GITHUB_TOKEN_FILE=.secrets/github_token

# PostgreSQL
PGPORT=5430
PGDATABASE=score_monitoramento
PGUSER=score_user
PGPASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# Aplicacao
API_PORT=3002
WEB_PORT=3001
ADMIN_TOKEN=TROQUE_POR_TOKEN_COM_PELO_MENOS_32_CARACTERES
NEXT_PUBLIC_API_BASE=http://192.168.1.115:3002/api/v1
