{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@configs/*": ["./configs/*"],
      "@constants/*": ["./constants/*"],
      "@controllers/*": ["./controllers/*"],
      "@migrations/*": ["./migrations/*"],
      "@models/*": ["./models/*"],
      "@routes/*": ["./routes/*"],
      "@serializers/*": ["./serializers/*"],
      "@services/*": ["./services/*"],
      "@swagger/*": ["./swagger/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "./node_modules",
    "./dist"
  ]
}
